# Lemon Squeezy webhook service — .env.example
# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ต้องอยู่ใน .gitignore ห้าม commit)

# Port ที่รันบริการ (default 3001)
PORT=3001

# เว็บโฮก secrète จาก Lemon Squeezy dashboard (ใช้ยืนยันลายเซ็น X-Signature)
LEMON_SQUEEZY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# GitHub fine-grained PAT (สิทธิ์ contents + administration บน repo เดียว)
GITHUB_TOKEN=replace_with_your_fine_grained_pat

# เจ้าของ repo และชื่อ repo สำหรับส่งคำเชิญ
GITHUB_OWNER=krisakornutama
GITHUB_REPO=sovereign-os-commercial
