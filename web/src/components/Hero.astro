---
import ShaderBG from './react/ShaderBG.tsx';
import GlassStats from './react/GlassStats.tsx';
---
<section class="relative overflow-hidden bg-gradient-to-b from-sovereign-50 dark:from-dark-900 to-white dark:to-dark-950 pt-16 pb-20 sm:pt-24 sm:pb-28 lg:pt-32 lg:pb-36">
  <!-- พื้นหลัง WebGL: shadergradient + ระบบภาพเดิม (grid/tint) ยังซ้อนด้านบน -->
  <div class="absolute inset-0 shader-slot pointer-events-none" aria-hidden="true">
    <ShaderBG client:only="react" />
  </div>
  <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-40 dark:opacity-50" aria-hidden="true" />
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white dark:from-dark-950/80 dark:via-dark-950/60 dark:to-dark-950" aria-hidden="true" />
  <div class="absolute inset-0 bg-gradient-to-r from-sovereign-500/5 via-transparent to-cyan-500/5" aria-hidden="true" />

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sovereign-50 dark:bg-sovereign-900/30 text-sovereign-700 dark:text-sovereign-300 text-sm font-medium mb-6 animate-fade-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sovereign-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-sovereign-500"></span>
        </span>
        <span>เวอร์ชัน 2.0 — อัปเดตล่าสุด 19 ตุลาคม 2569</span>
      </div>

      <p class="text-sm font-mono text-sovereign-600 dark:text-sovereign-400 tracking-widest uppercase mb-4 animate-slide-up">
        SELF-HOSTED LIFE &amp; BUSINESS OS
      </div>

      <h1 class="text-display-xl font-bold text-dark-950 dark:text-white mb-6 animate-slide-up">
        ระบบหลังบ้าน <span class="text-sovereign-600 dark:text-sovereign-400">ร้านค้า ร้านอาหาร ฟาร์ม</span>
        <br class="hidden sm:block" />
        ที่ <em class="text-sovereign-600 dark:text-sovereign-400">พร้อมส่งต่อนักบัญชี</em>
      </h1>

      <p class="text-body-lg text-dark-600 dark:text-dark-400 max-w-2xl mx-auto mb-10 animate-slide-up">
        ระบบหลังบ้านสำหรับร้านค้า ร้านอาหาร และฟาร์มปศุสัตว์: ขาย รับเงิน PromptPay แยก VAT ออกใบกำกับ ลงบัญชี และจัดรูปแบบข้อมูลให้พร้อมส่งต่อนักบัญชี/สรรพากร — self-hosted ทั้งหมด ฟรี
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up">
        <a href="#demo" class="btn-primary btn-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.553.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          ลองใช้งานฟรี
        </a>
        <a href="#features" class="btn-outline btn-lg">
          ดูคุณสมบัติทั้งหมด
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </a>
      </div>

      <!-- การ์ดสถิติแบบ Liquid Glass (island: hydrate เมื่อ scroll ถึง, fallback พื้นหลังไล่ระดับสีอยู่แล้ว) -->
      <div class="mt-10 flex justify-center animate-fade-in glass-placeholder">
        <GlassStats client:only="react" />
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm text-dark-500 dark:text-dark-400 animate-fade-in">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-sovereign-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.178-1.332 9-6.03 9-11.622 0-1.042-.13-2.062-.38-3.04z" />
          </svg>
          <span>Self-hosted 100%</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-sovereign-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
          </svg>
          <span>ข้อมูลอยู่เครื่องคุณ</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-sovereign-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>ไม่มีค่าใช้จ่ายรายเดือน</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-dark-400 dark:text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V4" />
    </svg>
  </div>
</section>