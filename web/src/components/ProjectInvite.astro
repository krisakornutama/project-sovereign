---
---
<section id="contact" class="py-12 sm:py-16 bg-sovereign-50 dark:bg-sovereign-900/20 rounded-2xl border border-sovereign-200 dark:border-sovereign-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
      <svg class="w-8 h-8 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v6m0-6h6m-6 0H6" />
      </svg>
    </div>
    <h2 class="text-heading-lg font-bold text-dark-950 dark:text-white mb-3">
      อยากเป็นส่วนหนึ่งของ Project Sovereign?
    </h2>
    <p class="text-body-lg text-dark-600 dark:text-dark-400 max-w-xl mx-auto mb-8">
      เรากำลังมองหาคนที่มีความหลงใหลเท่ากัน: นักพัฒนา นักออกแบบ นักเขียน ผู้เชี่ยวชาญธุรกิจ/ภาษี/ฟาร์ม/อุตสาหกรรม IoT — ใครก็ตามที่อยากสร้างเครื่องมือที่คนใช้งานจริง
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="p-4 rounded-lg bg-white dark:bg-dark-900 border border-dark-200 dark:border-dark-700">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
          <svg class="w-6 h-6 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2v-4M14 10h4m0 0l-4-4m0 0l4 4m-4-4h4m0 0v4" />
          </svg>
        </div>
        <h4 class="font-semibold text-dark-900 dark:text-white mb-1">นักพัฒนา</h4>
        <p class="text-sm text-dark-600 dark:text-dark-400">React/Next.js, Go, Rust, Python, Embedded C</p>
      </div>
      <div class="p-4 rounded-lg bg-white dark:bg-dark-900 border border-dark-200 dark:border-dark-700">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
          <svg class="w-6 h-6 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v2.5" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7" />
          </svg>
        </div>
        <h4 class="font-semibold text-dark-950 dark:text-white mb-1">นักออกแบบ UI/UX</h4>
        <p class="text-sm text-dark-600 dark:text-dark-400">Figma, Design System, Accessibility, Motion</p>
      </div>
      <div class="p-4 rounded-lg bg-white dark:bg-dark-900 border border-dark-200 dark:border-dark-700">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
          <svg class="w-6 h-6 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414c.39.39.39 1.024 0 1.414l-4 4a2 2 0 01-2.828 0L9.828 9.828a2 2 0 000 2.828l4.586 4.586a1 1 0 001.414 0l.014.014z" />
          </svg>
        </div>
        <h4 class="font-semibold text-dark-950 dark:text-white mb-1">นักเขียน/Technical Writer</h4>
        <p class="text-sm text-dark-600 dark:text-dark-400">เอกสาร API, คู่มือผู้ใช้, บล็อกเทคนิค, KB</p>
      </div>
      <div class="p-4 rounded-lg bg-white dark:bg-dark-900 border border-dark-200 dark:border-dark-700">
        <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
          <svg class="w-6 h-6 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428c2.38-1.94 2.38-5.185 0-7.071A5.185 5.185 0 0012 3.622 5.185 5.185 0 003.622 3.622 5.185 5.185 0 001.393 8.014l10.561 10.561a5.185 5.185 0 007.071 0l7.915-7.915a5.185 5.185 0 00-7.071-7.071l-8.15 8.15a5.185 5.185 0 010-7.071 5.185 5.185 0 017.071 0z" />
          </svg>
        </div>
        <h4 class="font-semibold text-dark-950 dark:text-white mb-1">Domain Experts</h4>
        <p class="text-sm text-dark-600 dark:text-dark-400">บัญชี/ภาษีไทย, ฟาร์ม/สัตว์/การเกษตร, IoT/Embedded, Retail/POS</p>
      </div>
    </div>

    <!-- ฟอร์มติดต่อ (พฤติกรรมเดิมจากหน้าผลงานรุ่นแรก: ตรวจครบก่อนรับ, ไม่มีเซิร์ฟเวอร์ของเว็บนี้)
         ป้องกันบ้าระยะ: ไม่มี POST ไป endpoint จริงจนกว่าจะตั้งค่าปลายทาง — แสดงข้อความสถานะเสมอ -->
    <form id="contactForm" novalidate class="mt-10 max-w-2xl mx-auto text-left">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cName" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-1.5">ชื่อ / ชื่อเล่น</label>
          <input id="cName" name="name" type="text" autocomplete="name" placeholder="เช่น พี่บอย" class="w-full rounded-lg border border-dark-300 dark:border-dark-600 bg-white dark:bg-dark-800 text-dark-900 dark:text-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sovereign-500 transition-colors" />
        </div>
        <div>
          <label for="cEmail" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-1.5">อีเมลตอบกลับ</label>
          <input id="cEmail" name="email" type="email" autocomplete="email" placeholder="you@example.com" class="w-full rounded-lg border border-dark-300 dark:border-dark-600 bg-white dark:bg-dark-800 text-dark-900 dark:text-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sovereign-500 transition-colors" />
        </div>
      </div>
      <div class="mt-4">
        <label for="cTopic" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-1.5">ชิ้นงานที่สนใจ</label>
        <select id="cTopic" name="topic" class="w-full rounded-lg border border-dark-300 dark:border-dark-600 bg-white dark:bg-dark-800 text-dark-900 dark:text-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sovereign-500 transition-colors">
          {['ยังเลือกไม่ได้ — สอบถามก่อน', 'Sovereign Business OS', 'Sovereign School', 'Sovereign IoT', 'SovereignGuard Mini', 'Sovereign Marketplace', 'ร่วมทีม/พาร์ตเนอร์'].map((t) => (
            <option value={t}>{t}</option>
          ))}
        </select>
      </div>
      <div class="mt-4">
        <label for="cMsg" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-1.5">ข้อความ</label>
        <textarea id="cMsg" name="message" rows="4" placeholder="เล่าสั้น ๆ ว่าสนใจตรงไหน อยากช่วยอะไร หรืออยากรู้อะไรเพิ่ม" class="w-full rounded-lg border border-dark-300 dark:border-dark-600 bg-white dark:bg-dark-800 text-dark-900 dark:text-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sovereign-500 transition-colors"></textarea>
      </div>
      <div class="mt-5 flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <button type="submit" class="btn-primary btn-lg">ส่งข้อความ</button>
        <p class="text-xs text-dark-500 dark:text-dark-400">* ฟอร์ม static — ตรวจข้อมูลฝั่งเว็บก่อน แล้วตั้งปลายทางจริงทีหลัง (ไม่มีสคริปต์ติดตาม)</p>
      </div>
      <p id="formMsg" role="status" aria-live="polite" class="mt-3 text-sm font-medium text-dark-700 dark:text-dark-200"></p>
    </form>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="https://github.com/krisakornutama/sovereign-origin/discussions" target="_blank" rel="noopener noreferrer" class="btn-primary btn-lg w-full sm:w-auto">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        ร่วมสนทนาบน GitHub Discussions
      </a>
      <a href="mailto:team@sovereign.local" class="btn-outline btn-lg w-full sm:w-auto">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        ส่งอีเมลมาทีม
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('contactForm');
      var msg = document.getElementById('formMsg');
      if (!form || !msg) return;
      var say = function (t, cls) { msg.textContent = t; msg.className = cls || 'mt-3 text-sm font-medium text-dark-700 dark:text-dark-200'; };
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = document.getElementById('cName').value.trim();
        var email = document.getElementById('cEmail').value.trim();
        if (!name) { say('กรอกให้ครบก่อนนะ: ชื่อ (และอีเมลตอบกลับ)'); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { say('รูปแบบอีเมลยังไม่ถูกต้อง — ลองอีกครั้ง'); return; }
        say('ตรวจครบแล้ว — ปลายทางส่งจริงยังไม่ได้ตั้งค่า: คุณส่งเรื่องนี้ตรง ๆ ได้ที่ GitHub Discussions หรืออีเมลที่กล่องด้านล่างขอบข้างบน');
      });
    })();
  </script>
</section>