---
---
<section id="demo" class="py-20 sm:py-28 bg-gradient-to-b from-sovereign-50 dark:from-dark-900 to-white dark:to-dark-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-sm font-mono text-sovereign-600 dark:text-sovereign-400 tracking-widest uppercase mb-4">ทดลองใช้งานจริง</p>
      <h2 class="text-display-lg font-bold text-dark-950 dark:text-white mb-6">
        ลองใช้งานจริง <span class="text-sovereign-600 dark:text-sovereign-400">ไม่ต้องสมัคร</span>
      </h2>
      <p class="text-body-lg text-dark-600 dark:text-dark-400 max-w-2xl mx-auto">
        เปิดใช้งานทันที โหมดทดลองมีข้อมูลตัวอย่างครบทุกโมดูล — POS, สต็อก, บัญชี, ภาษี, AI
        ลองขาย สั่งซื้อ ออกใบกำกับ ดูรายงาน ไปพร้อมกัน
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto" id="ops">
      <!-- แผงเดโม: ต่อจากเวอร์ชันเดิมที่ฝัง iframe (โดเมนเดโมในเครื่องเท่านั้น จึงไม่โหลดหน้าเว็บได้ทุกเครื่อง)
           เวอร์ชันนี้ชี้ไปที่หน้าเดโมสาธารณะที่มีจริง (demo.html) เพราะฉะนั้นไม่มีกรอบพัง ไม่มี error ค้าง -->
      <div class="relative bg-dark-950 dark:bg-dark-900 rounded-2xl overflow-hidden shadow-elevated border border-dark-200 dark:border-dark-700">
        <!-- Top bar (ตกแต่งเสมือนหน้าต่างแอป) -->
        <div class="flex items-center gap-2 px-4 py-3 bg-dark-900 dark:bg-dark-950 border-b border-dark-700">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <div class="flex-1 text-center">
            <span class="text-xs font-mono text-dark-400 dark:text-dark-500">Harvest Ledger — โหมดทดลอง</span>
          </div>
          <div class="flex gap-1.5 ml-auto">
            <div class="w-8 h-2 rounded bg-dark-700"></div>
            <div class="w-8 h-2 rounded bg-dark-700"></div>
            <div class="w-8 h-2 rounded bg-dark-700"></div>
          </div>
        </div>

        <!-- แท็บโมดูล (อ้างอิงชุดโมดูลในแอปจริง) -->
        <div class="flex flex-wrap border-b border-dark-700 bg-dark-800/50 dark:bg-dark-900/50 px-4">
          {['POS', 'สต็อก', 'บัญชี', 'ภาษี', 'AI', 'ตั้งค่า'].map((tab) => (
            <span class="py-3 px-4 text-sm font-medium text-dark-400 dark:text-dark-500">{tab}</span>
          ))}
        </div>

        <!-- ตัวแผงเนื้อหาเดโม (สถิตแบบลื่นตา โครงร่างแอป POS) -->
        <div class="h-[380px] sm:h-[440px] overflow-hidden relative">
          <div class="absolute inset-0 flex flex-col sm:flex-row">
            <!-- คอลัมน์เมนูสินค้า (โครงร่าง) -->
            <div class="sm:w-1/3 border-b sm:border-b-0 sm:border-r border-dark-700 p-5 space-y-3">
              {[3, 2, 4, 2, 3, 2].map((w, i) => (
                <div class="flex items-center gap-3">
                  <div class={`w-9 h-9 rounded-lg bg-dark-800 border border-dark-700 shrink-0 ${i % 2 ? 'bg-sovereign-900/40' : ''}`}></div>
                  <div class="flex-1 space-y-2">
                    <div class={`h-2.5 rounded bg-dark-800`} style={`width:${w * 12}%`}></div>
                    <div class="h-2 rounded bg-dark-800/60" style={`width:${w * 7}%`}></div>
                  </div>
                </div>
              ))}
            </div>
            <!-- โซนยอดรวม + โอกาสรับเงิน -->
            <div class="flex-1 p-6 flex flex-col">
              <div class="grid grid-cols-3 gap-3 mb-6">
                {['บิลวันนี้', 'ยอดขาย', 'VAT'].map((label) => (
                  <div class="p-3 rounded-lg bg-dark-800/70 border border-dark-700">
                    <p class="text-[10px] sm:text-xs font-mono text-dark-500 mb-1.5">{label}</p>
                    <div class="h-3.5 w-3/4 rounded bg-sovereign-700/70"></div>
                  </div>
                ))}
              </div>
              <div class="space-y-2.5 flex-1">
                {[10, 7, 9, 6].map((w) => <div class="h-2.5 rounded bg-dark-800" style={`width:${w}%`}></div>)}
              </div>
              <a
                href="/demo.html"
                class="btn-primary btn-lg mt-6 w-full justify-center"
                aria-label="เปิดโหมดทดลอง Harvest Ledger ฉบับเต็ม"
              >
                เปิดโหมดทดลองฉบับเต็ม
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- วิทเจ็ตงวดภาษี (เวอร์ชันแปลงจากหน้าแรกรุ่นแรก: เลือกงวด → ตราแบบ ภ.พ.30 + ตัวเลขภาษีเปลี่ยนตาม) -->
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-5xl mx-auto">
      <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-dark-900 border border-dark-200 dark:border-dark-700 shadow-card">
        <p class="text-sm font-mono text-sovereign-600 dark:text-sovereign-400 tracking-widest uppercase mb-4">ลองเลือกงวดภาษี</p>
        <h3 class="text-heading-md font-bold text-dark-950 dark:text-white mb-4">คิดภาษีอัตโนมัติรายงวด</h3>
        <label for="periodSel" class="block text-sm font-medium text-dark-600 dark:text-dark-400 mb-2">งวดภาษี (สลับได้ทันที)</label>
        <select id="periodSel" class="w-full rounded-lg border border-dark-300 dark:border-dark-600 bg-white dark:bg-dark-800 text-dark-900 dark:text-white px-4 py-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-sovereign-500 transition-colors">
          <option value="2569-09" selected>กันยายน 2569</option>
          <option value="2569-08">สิงหาคม 2569</option>
          <option value="2569-07">กรกฎาคม 2569</option>
        </select>
        <ul class="mt-5 space-y-2 text-sm text-dark-600 dark:text-dark-400 list-disc list-inside">
          <li><b class="text-dark-900 dark:text-white">ปฏิทินยื่น</b> 5 แบบ นับวันถอยหลังอัตโนมัติ — เหลือ ≤14 วันเริ่มเตือน</li>
          <li>อัตราตามกฎหมายจริง ณ ก.ย. 2569 (VAT 7% ถึง 30 ก.ย. 2570 แล้วขึ้น 10% เอง)</li>
        </ul>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-dark-950 dark:bg-dark-900 text-white border border-dark-700 shadow-elevated">
        <div class="inline-flex flex-col items-center px-5 py-3 rounded-xl border-2 border-emerald-400/70 text-emerald-300 mb-4" id="stampWrap" aria-label="ตรางวดภาษีบนแบบยื่น">
          <small class="text-[11px] font-mono tracking-widest text-emerald-400/80">งวดภาษี</small>
          <span class="text-lg font-bold" id="stampPeriod">กันยายน 2569</span>
        </div>
        <p class="text-xs font-mono text-dark-400 tracking-widest mb-2">แบบยื่นรายเดือน · กรมสรรพากร</p>
        <div class="text-display-md font-bold mb-2">แบบ ภ.พ.30</div>
        <p class="text-sm text-dark-400 mb-5">แบบแสดงรายการภาษีมูลค่าเพิ่ม ตามประมวลรัษฎากร</p>
        <p class="text-sm text-dark-400 mb-4">เลขประจำตัวผู้เสียภาษี <span class="inline-block w-24 border-b border-dashed border-dark-500 align-middle"></span></p>
        <div class="space-y-2.5 text-sm">
          <div class="flex items-center justify-between border-b border-dark-800 pb-2"><span><span class="text-dark-500 font-mono">๑</span> ภาษีขาย</span><b class="font-mono" id="amtOut">700.00</b></div>
          <div class="flex items-center justify-between border-b border-dark-800 pb-2"><span><span class="text-dark-500 font-mono">๒</span> ภาษีซื้อ</span><b class="font-mono" id="amtIn">210.00</b></div>
          <div class="flex items-center justify-between border-b border-dark-800 pb-2"><span><span class="text-dark-500 font-mono">๓</span> ภาษีซื้อยกมา</span><b class="font-mono" id="amtPrev">0.00</b></div>
          <div class="flex items-center justify-between"><span><span class="text-dark-500 font-mono">๔</span> ภาษีสุทธิ</span><b class="font-mono text-emerald-300" id="amtNet">490.00</b></div>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var PERIODS = {
          '2569-09': { label: 'กันยายน 2569', out: '700.00', in: '210.00', prev: '0.00', net: '490.00' },
          '2569-08': { label: 'สิงหาคม 2569', out: '560.00', in: '210.00', prev: '0.00', net: '350.00' },
          '2569-07': { label: 'กรกฎาคม 2569', out: '420.00', in: '70.00',  prev: '0.00', net: '350.00' }
        };
        var sel = document.getElementById('periodSel');
        var stamp = document.getElementById('stampPeriod');
        if (!sel || !stamp) return;
        var set = function (id, v) { var el = document.getElementById(id); if (el) el.textContent = v; };
        sel.addEventListener('change', function () {
          var d = PERIODS[sel.value];
          if (!d) return;
          stamp.textContent = d.label;
          set('amtOut', d.out); set('amtIn', d.in); set('amtPrev', d.prev); set('amtNet', d.net);
        });
      })();
    </script>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/demo.html" class="btn-primary btn-lg w-full sm:w-auto">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        เปิดโหมดทดลองเต็มหน้าจอ
      </a>
      <a href="#features" class="btn-outline btn-lg w-full sm:w-auto">
        ดูคุณสมบัติทั้งหมด
      </a>
    </div>

    <div class="mt-10 p-6 sm:p-8 bg-sovereign-50 dark:bg-sovereign-900/20 rounded-2xl border border-sovereign-200 dark:border-sovereign-800">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
            <svg class="w-6 h-6 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-dark-900 dark:text-white">ข้อมูลทดลองใช้งานครบทุกโมดูล</h4>
            <p class="text-sm text-dark-500 dark:text-dark-400 mt-1">สินค้า/ลูกค้า/ออเดอร์/สต็อก/บัญชี/ภาษี — พร้อมใช้ทันที</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-primary">POS</span>
          <span class="badge badge-success">สต็อก</span>
          <span class="badge badge-warning">บัญชี</span>
          <span class="badge badge-neutral">ภาษี</span>
          <span class="badge badge-primary">AI</span>
        </div>
      </div>
    </div>
  </div>
</section>
