---
---
<section id="demo" class="py-20 sm:py-28 bg-gradient-to-b from-sovereign-50 dark:from-dark-900 to-white dark:to-dark-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-sm font-mono text-sovereign-600 dark:text-sovereign-400 tracking-widest uppercase mb-4">ทดลองใช้งานจริง</p>
      <h2 class="text-display-lg font-bold text-dark-950 dark:text-white mb-6">
        ลองใช้งานจริง <span class="text-sovereign-600 dark:text-sovereign-400">ไม่ต้องสมัคร</span>
      </h2>
      <p class="text-body-lg text-dark-600 dark:text-dark-400 max-w-2xl mx-auto">
        เปิดใช้งานทันที โหมดทดลองมีข้อมูลตัวอย่างครบทุกโมดูล — POS, สต็อก, บัญชี, ภาษี, AI
        ลองขาย สั่งซื้อ ออกใบกำกับ ดูรายงาน ไปพร้อมกัน
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto">
      <!-- Demo iframe container -->
      <div class="relative bg-dark-950 dark:bg-dark-900 rounded-2xl overflow-hidden shadow-elevated border border-dark-200 dark:border-dark-700">
        <!-- Top bar -->
        <div class="flex items-center gap-2 px-4 py-3 bg-dark-900 dark:bg-dark-950 border-b border-dark-700">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500" />
            <div class="w-3 h-3 rounded-full bg-amber-500" />
            <div class="w-3 h-3 rounded-full bg-green-500" />
          </div>
          <div class="flex-1 text-center">
            <span class="text-xs font-mono text-dark-400 dark:text-dark-500">https://demo.sovereign.local</span>
          </div>
          <div class="flex gap-1.5 ml-auto">
            <div class="w-8 h-2 rounded bg-dark-700" />
            <div class="w-8 h-2 rounded bg-dark-700" />
            <div class="w-8 h-2 rounded bg-dark-700" />
          </div>
        </div>

        <!-- Demo tabs -->
        <div class="flex border-b border-dark-700 bg-dark-800/50 dark:bg-dark-900/50 px-4">
          {['POS', 'สต็อก', 'บัญชี', 'ภาษี', 'AI', 'ตั้งค่า'].map((tab) => (
            <button class="py-3 px-4 text-sm font-medium text-dark-400 dark:text-dark-400 hover:text-white dark:hover:text-white border-b-2 border-transparent hover:border-sovereign-500 transition-colors">
              {tab}
            </button>
          ))}
        </div>

        <!-- Demo content area -->
        <div class="h-[500px] sm:h-[600px] overflow-hidden relative">
          <iframe
            src="https://demo.sovereign.local"
            title="Sovereign Demo Sandbox"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer"
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals"
          ></iframe>

          <!-- Fallback for when iframe is blocked -->
          <div class="absolute inset-0 flex items-center justify-center bg-dark-900 dark:bg-dark-950 p-8 hidden" id="iframe-fallback">
            <div class="text-center max-w-md mx-auto">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
                <svg class="w-8 h-8 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 20h12" />
                </svg>
              </div>
              <h3 class="text-heading-md font-bold text-white mb-2">โหมดทดลองไม่สามารถโหลดได้</h3>
              <p class="text-dark-400 dark:text-dark-500 mb-4">
                เบราว์เซอร์ของคุณอาจบล็อก iframe หรือเครือข่ายไม่สามารถเชื่อมต่อได้
              </p>
              <a href="https://demo.sovereign.local" target="_blank" rel="noopener noreferrer" class="btn-primary btn-md inline-flex">
                เปิดโหมดทดลองในแท็บใหม่
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="https://demo.sovereign.local" target="_blank" rel="noopener noreferrer" class="btn-primary btn-lg w-full sm:w-auto">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        เปิดโหมดทดลองเต็มหน้าจอ
      </a>
      <a href="#features" class="btn-outline btn-lg w-full sm:w-auto">
        ดูคุณสมบัติทั้งหมด
      </a>
    </div>

    <div class="mt-10 p-6 sm:p-8 bg-sovereign-50 dark:bg-sovereign-900/20 rounded-2xl border border-sovereign-200 dark:border-sovereign-800">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-sovereign-100 dark:bg-sovereign-900/30 flex items-center justify-center">
            <svg class="w-6 h-6 text-sovereign-600 dark:text-sovereign-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-dark-900 dark:text-white">ข้อมูลทดลองใช้งานครบทุกโมดูล</h4>
            <p class="text-sm text-dark-500 dark:text-dark-400 mt-1">สินค้า/ลูกค้า/ออเดอร์/สต็อก/บัญชี/ภาษี — พร้อมใช้ทันที</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-primary">POS</span>
          <span class="badge badge-success">สต็อก</span>
          <span class="badge badge-warning">บัญชี</span>
          <span class="badge badge-neutral">ภาษี</span>
          <span class="badge badge-primary">AI</span>
        </div>
      </div>
    </div>
  </div>
</section>