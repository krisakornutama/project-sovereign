<meta name="theme-color" content="#030712" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23030712'/%3E%3Cpath d='M4 5h8v3H4z' fill='%2334d399'/%3E%3Cpath d='M5 8v3.5M8 8v3.5M11 8v3.5' stroke='%2322d3ee' stroke-width='1.4' stroke-linecap='round'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+Thai+Looped:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style is:inline>
:root{
  --bg:#030712; --panel:rgba(17,24,39,.55); --line:rgba(52,211,153,.16);
  --green:#34d399; --cyan:#22d3ee; --txt:#e5e7eb; --dim:#9ca3af; --faint:#6b7280;
  --thai:'IBM Plex Sans Thai Looped','Noto Sans Thai Looped','Segoe UI',sans-serif;
  --mono:'JetBrains Mono','Noto Sans Thai Looped','Cascadia Code','Courier New',monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);font-family:var(--thai);line-height:1.65;-webkit-font-smoothing:antialiased}
body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background:
  radial-gradient(1100px 620px at 10% -12%,rgba(52,211,153,.11),transparent 62%),
  radial-gradient(980px 620px at 90% -8%,rgba(34,211,238,.10),transparent 64%),
  radial-gradient(1200px 700px at 50% 115%,rgba(52,211,153,.06),transparent 62%)}
body::after{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:
  linear-gradient(rgba(52,211,153,.02) 1px,transparent 1px),
  linear-gradient(90deg,rgba(34,211,238,.015) 1px,transparent 1px);background-size:36px 36px;
  -webkit-mask-image:radial-gradient(1200px 700px at 50% 40%,#000 30%,transparent 100%);
  mask-image:radial-gradient(1200px 700px at 50% 40%,#000 30%,transparent 100%)}
::selection{background:rgba(52,211,153,.35);color:#ecfdf5}
:focus-visible{outline:2px solid var(--green);outline-offset:2px;border-radius:6px}
a{color:var(--green)}

.topbar{position:sticky;top:0;z-index:50;display:flex;justify-content:space-between;align-items:center;gap:12px;
  padding:13px 24px;border-bottom:1px solid var(--line);background:rgba(3,7,18,.86);backdrop-filter:blur(8px)}
.topnav{display:flex;gap:15px;font-family:var(--mono);font-size:.72rem;overflow-x:auto;white-space:nowrap;scrollbar-width:none}
.topnav::-webkit-scrollbar{display:none}
.topnav a{color:var(--dim);text-decoration:none}
.topnav a:hover{color:var(--green)}
.topnav a[aria-current="page"]{color:var(--green);border-bottom:1px solid var(--green)}

.hero{max-width:1080px;margin:0 auto;padding:70px 24px 56px}
.eyebrow{font-family:var(--mono);font-size:.7rem;letter-spacing:.22em;color:var(--cyan);margin:0 0 14px}
h1{font-size:clamp(1.9rem,5vw,3.2rem);font-weight:700;line-height:1.2;margin:0 0 18px;max-width:800px}
h1 em{font-style:normal;color:var(--green);text-shadow:0 0 24px rgba(52,211,153,.35)}
.lede{color:var(--dim);font-size:1.02rem;max-width:680px;margin:0 0 26px}
.meta-line{font-family:var(--mono);font-size:.72rem;color:var(--faint);margin:0 0 30px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;font-weight:600;font-size:.9rem;text-decoration:none;padding:11px 22px;border-radius:9px;transition:box-shadow .15s ease,background .15s ease,border-color .15s ease;cursor:pointer}
.btn-primary{background:var(--green);color:#030712}
.btn-primary:hover{box-shadow:0 0 26px rgba(52,211,153,.4)}
.btn-ghost{border:1px solid rgba(52,211,153,.4);color:var(--green);background:transparent}
.btn-ghost:hover{border-color:var(--green);background:rgba(52,211,153,.08)}

html{scroll-padding-top:70px}
section{max-width:1080px;margin:0 auto;padding:64px 24px;scroll-margin-top:70px}
.k-ch{font-family:var(--mono);font-size:.7rem;letter-spacing:.18em;color:var(--cyan);margin:0 0 10px}
.k-ch b{color:var(--green)}
h2{font-size:1.6rem;font-weight:600;margin:0 0 8px}
.sub{color:var(--dim);font-size:.92rem;margin:0 0 34px;max-width:680px}
.bullet{color:var(--dim);font-size:.88rem;padding-left:20px;margin:0;line-height:2}
.bullet b,.hl{color:#ecfdf5}
code.c{font-family:var(--mono);font-size:.78rem;color:#a7f3d0;background:rgba(3,7,12,.7);border:1px solid var(--line);border-radius:6px;padding:2px 8px}

/* ── POS board ── */
.board{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:start}
.pane{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:20px 22px}
.pane .pt{font-family:var(--mono);font-size:.64rem;letter-spacing:.14em;color:var(--green);margin:0 0 12px}
.pane label{display:block;font-family:var(--mono);font-size:.66rem;color:var(--faint);margin:12px 0 5px}
.pane input{width:100%;font-family:var(--mono);font-size:.85rem;color:#a7f3d0;background:#0b1220;
  border:1px solid rgba(34,211,153,.35);border-radius:8px;padding:9px 12px}
.row3{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px}
.cart{width:100%;border-collapse:collapse;font-size:.83rem;margin-top:14px}
.cart th{font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;color:var(--faint);text-align:left;padding:6px 6px;border-bottom:1px solid var(--line)}
.cart td{padding:7px 6px;border-bottom:1px solid rgba(52,211,153,.08);color:var(--dim)}
.cart td.nm{color:#ecfdf5}
.cart .x{background:none;border:none;color:var(--faint);cursor:pointer;font-size:.9rem;padding:0 4px}
.cart .x:hover{color:#f87171}
.totalrow{display:flex;justify-content:space-between;align-items:baseline;margin-top:12px;font-family:var(--mono)}
.totalrow .tv{font-size:1.25rem;color:var(--green);font-weight:700}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.sbtn{font-family:var(--mono);font-size:.74rem;padding:9px 14px;border-radius:8px;cursor:pointer;
  border:1px solid rgba(52,211,153,.4);background:transparent;color:var(--green)}
.sbtn:hover{background:rgba(52,211,153,.08)}
.sbtn.solid{background:var(--green);color:#030712;border-color:var(--green);font-weight:700}
.sbtn.solid:hover{box-shadow:0 0 20px rgba(52,211,153,.35)}
.sbtn.danger{border-color:rgba(248,113,113,.45);color:#f87171}
.sbtn.danger:hover{background:rgba(248,113,113,.08)}
.pill{display:inline-block;font-family:var(--mono);font-size:.68rem;padding:6px 12px;border-radius:99px;
  border:1px solid rgba(52,211,153,.4);color:var(--green);background:rgba(52,211,153,.06);margin-bottom:14px}
.pill.off{border-color:rgba(251,191,36,.5);color:#fbbf24;background:rgba(251,191,36,.07)}
.msg{font-size:.8rem;color:#fbbf24;min-height:1.4em;margin-top:10px}
.bills{margin-top:6px}
.bill{display:flex;justify-content:space-between;align-items:center;gap:10px;border:1px solid rgba(52,211,153,.14);
  border-radius:9px;padding:10px 12px;margin:8px 0;background:rgba(3,7,12,.5)}
.bill .bi{font-family:var(--mono);font-size:.7rem;color:var(--faint)}
.bill .bt{font-family:var(--mono);font-size:.86rem;color:var(--green);font-weight:600}
.bill .bd{font-size:.72rem;color:var(--dim)}
.bill .x{background:none;border:none;color:var(--faint);cursor:pointer;font-size:.95rem}
.bill .x:hover{color:#f87171}
.empty{font-size:.78rem;color:var(--faint);font-family:var(--mono)}

.honest{border:1px dashed rgba(245,158,11,.4);background:rgba(245,158,11,.05);border-radius:12px;padding:20px 24px}
.honest h3{margin:0 0 10px;font-size:.95rem;color:#fbbf24}
.honest ul{margin:0;padding-left:20px}
.honest li{font-size:.85rem;color:var(--dim);margin:6px 0}

footer{border-top:1px solid var(--line);text-align:center;padding:30px 24px 40px;
  font-family:var(--mono);font-size:.7rem;color:var(--faint);line-height:2}

@media (max-width:900px){
  .board{grid-template-columns:1fr;gap:30px}
  .hero{padding:56px 20px 46px}
  section{padding:52px 20px}
}
@media (max-width:480px){
  .topnav{gap:10px;font-size:.64rem}
  .row3{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
</style>
