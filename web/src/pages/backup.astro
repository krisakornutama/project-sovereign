<script is:inline src="nav.js" defer></script>
<script is:inline>
(function(){
  'use strict';
  var KEY = 'sovereign_bk_check';
  var boxes = [].slice.call(document.querySelectorAll('#bkList input[type=checkbox]'));
  var bar = document.getElementById('bkBar');
  var saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { saved = {}; }
  function paint(){
    var done = 0;
    boxes.forEach(function(b){ if (b.checked) done++; });
    var pct = boxes.length ? Math.round(done * 100 / boxes.length) : 0;
    bar.textContent = 'ความครบ ' + done + '/' + boxes.length + ' — ' + pct + '%';
  }
  boxes.forEach(function(b, i){
    b.checked = !!saved[i];
    b.addEventListener('change', function(){
      saved[i] = b.checked;
      try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {}
      paint();
    });
  });
  paint();
})();
</script>
