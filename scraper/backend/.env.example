PORT=4000
FRONTEND_URL=http://localhost:5173
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# REQUIRED — signs the customer identity token.
# Without it the API refuses to issue tokens (fails closed) and every customer
# falls into one shared bucket. Generate once and never change it: changing it
# invalidates every token already in a browser, which strands paid credits.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_TOKEN_SECRET=

# REQUIRED to read GET /api/billing/payments. Without it that route returns 503.
ADMIN_TOKEN=

# Optional. Extra browser origins allowed by CORS, comma-separated.
# CORS_EXTRA_ORIGINS=https://example.com

# Where the SQLite file lives. Point this at a mounted volume in production —
# the default sits next to the code, which is wiped on every Railway deploy.
# SCRAPER_DB_PATH=/data/scraper-data.sqlite
